<?xml version="1.0"?>
<package format="3">
  <name>urrc_track_gazebo</name>
  <version>0.1.0</version>
  <description>1/10 F1-inspired LiDAR cone racing circuits for ROS 2 Jazzy + Gazebo Harmonic.</description>
  <maintainer email="student@example.com">URRC Team</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_python</buildtool_depend>
  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>ros_gz_sim</exec_depend>

  <test_depend>ament_pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
